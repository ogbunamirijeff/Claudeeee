{
  "expo": {
    "name": "Jiko",
    "slug": "jiko",
    "scheme": "jiko",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "runtimeVersion": { "policy": "appVersion" },
    "ios": {
      "bundleIdentifier": "com.jiko.app",
      "supportsTablet": false,
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": { "package": "com.jiko.app", "softwareKeyboardLayoutMode": "pan" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Jiko uses your photos so you can show the pro what needs fixing.",
          "cameraPermission": "Jiko uses the camera so you can photograph the problem or the finished job.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": { "typedRoutes": false }
  }
}
