# ─── Jiko environment ─────────────────────────────────────────────────────────
# Copy to apps/api/.env (API) — web and mobile have their own .env.example files.
# Generate secrets with:  openssl rand -base64 48   (keys: openssl rand -base64 32)

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://jiko:jiko@localhost:5432/jiko?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
# Set true behind Railway/Render so req.ip is the client IP (used for OTP rate limits + audit)
TRUST_PROXY=false

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_PEPPER=change-me-to-another-long-random-string-32-chars
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20

# Field encryption for bank account numbers (AES-256-GCM). 32 random bytes, base64.
# To rotate: move the current key into PREVIOUS_KEYS as "<id>:<key>", set a new id + key.
DATA_ENCRYPTION_KEY_ID=k1
DATA_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32
DATA_ENCRYPTION_PREVIOUS_KEYS=

# SMS: "console" prints OTPs to the API log (dev only; refused in production).
# Production: Twilio with an A2P 10DLC campaign (Messaging Service) or a verified toll-free number.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Payments (Phase 3): Stripe Connect (Express accounts, separate charges and transfers)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Market (Houston pilot)
MARKET_TIMEZONE=America/Chicago

# Business rules
COMMISSION_BPS=1500
# Materials released when the job starts on site are capped (cents); the rest waits for completion.
MATERIALS_ADVANCE_CAP_CENTS=50000
# Quotes with materials above this share of the total (bps) need admin approval before payment.
MATERIALS_REVIEW_THRESHOLD_BPS=7000

# File storage. "local" = files on disk behind signed API URLs (dev only; refused in production).
PUBLIC_API_URL=http://localhost:4000
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_BUCKET_JOBS=jiko-jobs
S3_BUCKET_PRIVATE=jiko-private
SIGNED_URL_TTL_SECONDS=300

# Background jobs (BullMQ on Redis)
JOBS_WORKER_ENABLED=true
OFFER_SWEEP_INTERVAL_MS=60000
QUEUE_PREFIX=jiko

# Seed (prisma/seed/reference.ts): phone of the first admin user
SEED_ADMIN_PHONE=+17135550100
SEED_ADMIN_NAME=Jiko Ops
