# ─── Jiko environment ─────────────────────────────────────────────────────────
# Copy to apps/api/.env (API) — web and mobile have their own .env.example files.
# Generate secrets with:  openssl rand -base64 48   (keys: openssl rand -base64 32)

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://jiko:jiko@localhost:5432/jiko?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
# Set true behind Railway/Render so req.ip is the client IP (used for OTP rate limits + audit)
TRUST_PROXY=false

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_PEPPER=change-me-to-another-long-random-string-32-chars
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20

# Field encryption for bank account numbers (AES-256-GCM). 32 random bytes, base64.
# To rotate: move the current key into PREVIOUS_KEYS as "<id>:<key>", set a new id + key.
DATA_ENCRYPTION_KEY_ID=k1
DATA_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32
DATA_ENCRYPTION_PREVIOUS_KEYS=

# SMS: "console" prints OTPs to the API log (dev only; refused in production)
SMS_PROVIDER=console
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_API_KEY=
TERMII_SENDER_ID=Jiko
TERMII_CHANNEL=dnd

# Business rules
COMMISSION_BPS=1500

# Seed (prisma/seed/reference.ts): phone of the first admin user
SEED_ADMIN_PHONE=+2348000000001
SEED_ADMIN_NAME=Jiko Ops
